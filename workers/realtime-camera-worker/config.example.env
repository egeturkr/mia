# MIA Gerçek Zamanlı Kamera Worker — yapılandırma örneği (Faz 15)
# Kopyala: cp config.example.env .env  →  doldur  →  yükle: set -a; source .env; set +a
# GÜVENLİK: gerçek .env ASLA repo'ya girmez; RTSP adresleri cameras.json'da (gitignore'lu).

# --- Zorunlu ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Boş bırakılırsa: worker çalışır (heartbeat/sağlık) ama ÇIKARIM YAPMAZ, olay üretmez (dürüst mod).
ROBOFLOW_API_KEY=

# --- Model ---
ROBOFLOW_MODEL_ID=construction-site-safety/27
ROBOFLOW_MODEL_VERSION=rf-27

# --- Worker kimliği ---
WORKER_ID=

# --- Davranış (varsayılanlar üretim-makul) ---
DEFAULT_SAMPLING_SECONDS=5            # kamera sampling_fps tanımsızsa kare aralığı
DEFAULT_CONFIDENCE_THRESHOLD=0.45     # 0..1 — altı tespitler atılır
EVENT_DEDUP_SECONDS=60                # aynı kamera+ihlal tipi: pencere başına 1 olay
ALERT_THROTTLE_SECONDS=300            # yüksek risk e-postası: kamera+tip başına 5 dk'da 1

# --- Kanıt politikası ---
# VARSAYILAN false. true istense bile v1'de görüntü SAKLANMAZ (uygulanmadı) —
# açılması için: müşteri onayı + KVKK dayanağı + saklama/silme politikası +
# özel (private) bucket + imzalı URL + hukuk onayı ZORUNLU.
SNAPSHOT_STORAGE_ENABLED=false

# --- Opsiyonel: yüksek risk e-posta alarmı ---
ALERT_EMAIL=
RESEND_API_KEY=
