{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/login", "destination": "/giris-yap", "permanent": true },
    { "source": "/login.html", "destination": "/giris-yap", "permanent": true },
    { "source": "/signup", "destination": "/kaydol", "permanent": true },
    { "source": "/register", "destination": "/kaydol", "permanent": true },
    { "source": "/verify", "destination": "/dogrulama", "permanent": false },
    { "source": "/reset-password", "destination": "/sifre-sifirla", "permanent": true },
    { "source": "/demo", "destination": "/detector", "permanent": false },
    { "source": "/demo.html", "destination": "/detector", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
