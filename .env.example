# =============================================================================
# MIA — Environment Variables Reference
# =============================================================================
# This is a static HTML site (no build step) that talks directly to Supabase
# from the browser. The variables below are:
#   * documentation only — they are NOT auto-loaded by HTML pages
#   * mirror the values you must set in the Supabase Dashboard and at your host
#
# To override the client-side Supabase config at runtime, add this snippet to
# an HTML page BEFORE js/app.js loads:
#
#   <script>
#     window.MIA_SUPABASE_URL = "https://YOUR-PROJECT.supabase.co";
#     window.MIA_SUPABASE_KEY = "YOUR-ANON-KEY";
#   </script>
#
# Or your hosting platform (Vercel, Netlify, etc.) can inject them at deploy
# time through an environment-variable snippet.
# =============================================================================

# ---- Supabase project (client-side, public anon key — safe to expose) ----
SUPABASE_URL=https://qojtokomfcporcglrsdy.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # see Project Settings → API

# ---- Service role key (server / admin operations only — NEVER ship to browser) ----
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Public site URL (used by Supabase email redirects) ----
SITE_URL=https://miaissagligi.com

# ---- Outgoing email (configured in Supabase → Auth → SMTP Settings) ----
EMAIL_FROM=noreply@miaissagligi.com
EMAIL_FROM_NAME=MIA AI Safety Intelligence
EMAIL_REPLY_TO=info@miaissagligi.com

# ---- SMTP credentials (entered in Supabase Dashboard, not the codebase) ----
# Examples for common providers:
#   Resend:    smtp.resend.com   port 587   user: resend   pass: re_xxx
#   SendGrid:  smtp.sendgrid.net port 587   user: apikey   pass: SG.xxx
#   Postmark:  smtp.postmarkapp.com port 587 user: <token> pass: <token>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxx

# =============================================================================
# PRODUCTION HARDENING — Faz 1 (sunucusuz fonksiyon ortam değişkenleri)
# Bunlar Netlify → Site settings → Environment variables içine girilir.
# =============================================================================
# AI çıkarım sağlayıcıları (sunucuda gizli kalır — tarayıcıya ASLA gönderilmez)
ROBOFLOW_API_KEY=rf_xxxxxxxx
MODAL_URL=https://YOUR-MODAL-APP--detect-video.modal.run   # eski hardcoded URL buraya taşındı

# Yüksek risk e-posta uyarıları (/api/notify — sunucu tarafı)
RESEND_API_KEY=re_xxxxxxxx
MIA_FROM_EMAIL=MIA İş Sağlığı <bildirim@miaissagligi.com>

# Tarama ingestion (headless RFID/QR okuyucular) paylaşılan gizli token
MIA_SCAN_TOKEN=uzun-rastgele-gizli-bir-deger

# Faturalandırma webhook'u (Faz 5) — ödeme sağlayıcısı bağlanınca kullanılır
MIA_BILLING_SECRET=uzun-rastgele-gizli-bir-deger

# ---- Faz 6: Ödeme sağlayıcı yapılandırması (hepsi SUNUCU tarafı — tarayıcıya gitmez) ----
# manual: havale/EFT + MIA ekibinin manuel aktivasyonu (varsayılan, CANLI akış)
# iyzico: anahtarlar girilince sandbox; canlı tahsilat için BILLING_MODE=live + merchant onayı
BILLING_PROVIDER=manual
BILLING_MODE=sandbox
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# STRIPE_SECRET_KEY=        # gelecekte — arayüz rezerve, entegre değil
# STRIPE_WEBHOOK_SECRET=

# ---- Faz 10: İzleme (hepsi opsiyonel — yokluğu ürünü BOZMAZ) ----
OPS_LOGGING_ENABLED=true
# OPS_ALERT_EMAIL=info@miaissagligi.com   # kritik alarm e-postası (manuel süreç, runbook'a bak)
# SENTRY_DSN=                              # harici hata izleme bağlanırsa (kurulmadı)

# ---- Faz 12: Gerçek zamanlı kamera worker'ı (AYRI SERVİSTE çalışır — Netlify'da değil) ----
# Worker host'unda gerekli env'ler: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ROBOFLOW_API_KEY
# Opsiyonel: ALERT_EMAIL (yüksek risk e-postası), RF_CONFIDENCE, DEDUP_WINDOW_SEC, WORKER_ID
# RTSP adresleri workers/realtime-camera-worker/cameras.json'da tutulur (repo dışı).

# Rate-limit/kota ve JWT doğrulaması için (guard.js kullanır)
#   SUPABASE_URL + SUPABASE_ANON_KEY (yukarıda) + SUPABASE_SERVICE_ROLE_KEY gerekir
# İsteğe bağlı: ek izinli origin'ler (virgülle). Varsayılan: canlı domain + *.netlify.app
MIA_ALLOWED_ORIGINS=https://miaissagligi.com,https://www.miaissagligi.com

# ---- MIA company addresses (informational — provision inboxes with your mail host) ----
EMAIL_DENIZ=denizoge@miaissagligi.com
EMAIL_EGE=egeturker@miaissagligi.com
EMAIL_GOKBERK=gokberksahin@miaissagligi.com
EMAIL_INFO=info@miaissagligi.com
EMAIL_NOREPLY=noreply@miaissagligi.com
